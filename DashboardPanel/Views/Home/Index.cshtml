@{
    ViewData["Title"] = "Home Page";
}

<!-- MAIN – Sayfa içeriği alanı -->
<main class="layout">
    <!-- Sayfa başlığı: ikon, başlık, açıklama -->
    <div class="page-head">
        <div class="page-icon">
            ⌂
        </div>
        <div>
            <h1>Genel Bakış</h1>
            <p>Tüm önemli göstergeler ve hızlı işlemler tek bakışta.</p>
        </div>
    </div>
    <!-- Hızlı işlemler: yatırma, çekim, yeni müşteri -->
    <div class="quick-grid">
        <button class="quick-card green" data-go="deposit-1">
            <span class="quick-icon">
                <svg class="svg-icon" viewbox="0 0 24 24" aria-hidden="true" fill="none"
                     stroke="currentcolor" stroke-width="1.8" stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M12 4v14M6.5 12.5 12 18l5.5-5.5"></path>
                </svg>
            </span><span class="quick-copy">
                <strong>Yatırma</strong><small>
                    Para
                    yatır
                </small>
            </span>
        </button> <button class="quick-card red"
                          data-go="payout-1">
            <span class="quick-icon">
                <svg class="svg-icon" viewbox="0 0 24 24"
                     aria-hidden="true" fill="none" stroke="currentcolor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 20V6M6.5 11.5 12 6l5.5 5.5"></path>
                </svg>
            </span><span class="quick-copy">
                <strong>Çekim</strong><small>
                    Para
                    çek
                </small>
            </span>
        </button> <button class="quick-card blue"
                          data-go="create-user">
            <span class="quick-icon">
                <svg class="svg-icon" viewbox="0 0 24 24"
                     aria-hidden="true" fill="none" stroke="currentcolor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="10" cy="8" r="3"></circle>
                    <path d="M4.5 19c.7-3.1 2.6-4.8 5.5-4.8s4.8 1.7 5.5 4.8M18 7v6M15 10h6"></path>
                </svg>
            </span><span class="quick-copy">
                <strong>Yeni Müşteri</strong><small>
                    Yeni müşteri
                    oluştur
                </small>
            </span>
        </button>
    </div>
    <!-- Dashboard ızgarası: KPI kartları ve menü listesi -->
    <div class="dash-grid">
        <section class="card card-pad">
            <h2 class="section-title overview-title">Genel Bakış</h2>
            <!-- Tarih sekmeleri: bugün, dün, hafta, ay -->
            <div class="date-tabs">
                <button class="tab active" data-period="today">Bugün</button><button class="tab"
                                                                                     data-period="yesterday">
                    Dün
                </button><button class="tab" data-period="week">
                    1
                    Hafta
                </button><button class="tab" data-period="month">Bu Ay</button>
            </div><button class="custom-date" data-custom-range="">
                <span>
                    <svg class="svg-icon"
                         viewbox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentcolor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                        <path d="M7 3v4m10-4v4M3 10h18"></path>
                    </svg>
                </span><span class="custom-date-label">Özel Tarih Aralığı</span><span>
                    <svg class="svg-icon" viewbox="0 0 24 24" aria-hidden="true" fill="none"
                         stroke="currentcolor" stroke-width="1.8" stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="m9 5 7 7-7 7"></path>
                    </svg>
                </span>
            </button>
            <!-- KPI alanları: yatırma, çekim, kâr, açık bahisler -->
            <div class="kpis">
                <div class="kpi green">
                    <div class="kpi-icon">
                        <svg class="svg-icon" viewbox="0 0 24 24" aria-hidden="true" fill="none"
                             stroke="currentcolor" stroke-width="1.8" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M4 7.5h13.5A2.5 2.5 0 0 1 20 10v8a2 2 0 0 1-2 2H5a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3h11v3.5">
                            </path>
                            <path d="M15 11h5v5h-5a2.5 2.5 0 0 1 0-5Z"></path>
                            <circle cx="15.5" cy="13.5" r=".6" fill="currentColor" stroke="none"></circle>
                        </svg>
                    </div><label>Yatırma</label><strong data-kpi="deposit">17.628,00</strong>
                </div>
                <div class="kpi red">
                    <div class="kpi-icon">
                        <svg class="svg-icon" viewbox="0 0 24 24" aria-hidden="true" fill="none"
                             stroke="currentcolor" stroke-width="1.8" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M4 7.5h13.5A2.5 2.5 0 0 1 20 10v8a2 2 0 0 1-2 2H5a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3h11v3.5">
                            </path>
                            <path d="M15 11h5v5h-5a2.5 2.5 0 0 1 0-5Z"></path>
                            <circle cx="15.5" cy="13.5" r=".6" fill="currentColor" stroke="none"></circle>
                        </svg>
                    </div><label>Çekim</label><strong data-kpi="payout">13.204,00</strong>
                </div>
                <div class="kpi orange">
                    <div class="kpi-icon">
                        <svg class="svg-icon" viewbox="0 0 24 24" aria-hidden="true" fill="none"
                             stroke="currentcolor" stroke-width="1.8" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M3 20h18M5 16l4-5 4 3 7-9M16 5h4v4"></path>
                        </svg>
                    </div><label>Kâr</label><strong data-kpi="profit">4.424,00</strong>
                </div>
                <div class="kpi violet">
                    <div class="kpi-icon">
                        <svg class="svg-icon" viewbox="0 0 24 24" aria-hidden="true" fill="none"
                             stroke="currentcolor" stroke-width="1.8" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M5 4h14a1 1 0 0 1 1 1v4a3 3 0 0 0 0 6v4a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-4a3 3 0 0 0 0-6V5a1 1 0 0 1 1-1Z">
                            </path>
                            <path d="M12 7v2m0 2v2m0 2v2"></path>
                        </svg>
                    </div><label>Açık Bahisler</label><strong data-kpi="open">42</strong>
                </div>
            </div>
        </section>
        <section class="card card-pad">
            <h2 class="section-title">Menü</h2>
            <div class="menu-list">
                <a class="menu-entry primary-icon" href="/turnover">
                    <span>
                        <svg class="svg-icon"
                             viewbox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentcolor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 3v18M16 7.5c-.8-1-2-1.5-4-1.5-2.2 0-3.5 1.1-3.5 2.7 0 4.1 7.5 1.7 7.5 6 0 1.8-1.6 3.3-4.2 3.3-1.8 0-3.4-.7-4.3-1.9">
                            </path>
                        </svg>
                    </span><span>
                        <strong>Muhasebe</strong><small>
                            Mağaza Cirosu ve Acente
                            Cirosu
                        </small>
                    </span><span class="chev">
                        <svg class="svg-icon"
                             viewbox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentcolor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m9 5 7 7-7 7"></path>
                        </svg>
                    </span>
                </a><a class="menu-entry" href="/coupons">
                    <span>
                        <svg class="svg-icon" viewbox="0 0 24 24" aria-hidden="true" fill="none"
                             stroke="currentcolor" stroke-width="1.8" stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M5 4h14a1 1 0 0 1 1 1v4a3 3 0 0 0 0 6v4a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-4a3 3 0 0 0 0-6V5a1 1 0 0 1 1-1Z">
                            </path>
                            <path d="M12 7v2m0 2v2m0 2v2"></path>
                        </svg>
                    </span><span>
                        <strong>Bahis Kuponları</strong><small>
                            Kuponları
                            Yönet
                        </small>
                    </span><span class="chev">
                        <svg class="svg-icon" viewbox="0 0 24 24"
                             aria-hidden="true" fill="none" stroke="currentcolor" stroke-width="1.8"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="m9 5 7 7-7 7"></path>
                        </svg>
                    </span>
                </a><a class="menu-entry" href="/customers">
                    <span>
                        <svg class="svg-icon" viewbox="0 0 24 24" aria-hidden="true" fill="none"
                             stroke="currentcolor" stroke-width="1.8" stroke-linecap="round"
                             stroke-linejoin="round">
                            <circle cx="9" cy="8" r="3"></circle>
                            <path d="M3.5 19c.7-3.1 2.6-4.8 5.5-4.8 1.3 0 2.4.3 3.3 1M17 14a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm2.2 5.2L22 22">
                            </path>
                        </svg>
                    </span><span>
                        <strong>Müşteri Arama</strong><small>
                            Profili
                            Düzenle
                        </small>
                    </span><span class="chev">
                        <svg class="svg-icon"
                             viewbox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentcolor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m9 5 7 7-7 7"></path>
                        </svg>
                    </span>
                </a><button class="menu-entry"
                                 data-go="deposit-transactions">
                    <span>
                        <svg class="svg-icon" viewbox="0 0 24 24"
                             aria-hidden="true" fill="none" stroke="currentcolor" stroke-width="1.8"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 9h15a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3h9">
                            </path>
                            <path d="M16 13h5v5h-5a2.5 2.5 0 0 1 0-5ZM14 2v7M10.5 5.5 14 9l3.5-3.5"></path>
                        </svg>
                    </span><span>
                        <strong>Yatırma İşlemleri</strong><small>
                            Yatırma
                            Geçmişi
                        </small>
                    </span><span class="chev">
                        <svg class="svg-icon"
                             viewbox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentcolor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m9 5 7 7-7 7"></path>
                        </svg>
                    </span>
                </button><button class="menu-entry"
                                 data-go="payout-transactions">
                    <span>
                        <svg class="svg-icon" viewbox="0 0 24 24"
                             aria-hidden="true" fill="none" stroke="currentcolor" stroke-width="1.8"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 9h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3h8">
                            </path>
                            <path d="M15 13h5v5h-5a2.5 2.5 0 0 1 0-5Z"></path>
                            <path d="M12 10 19 3M14 3h5v5"></path>
                        </svg>
                    </span><span>
                        <strong>Çekim İşlemleri</strong><small>
                            Çekim
                            Geçmişi
                        </small>
                    </span><span class="chev">
                        <svg class="svg-icon"
                             viewbox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentcolor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m9 5 7 7-7 7"></path>
                        </svg>
                    </span>
                </button>
            </div>
        </section>
    </div>
</main>
