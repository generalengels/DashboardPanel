                         stroke-linejoin="round">
                        <path d="M3 20h18M5 16l4-5 4 3 7-9M16 5h4v4"></path>
                    </svg>
                </div><label>Kâr</label><strong style="color:var(--blue)">61.096,00</strong>
                <div class="spark" style="border-bottom:2px solid var(--blue);transform:skewY(-5deg)">
                </div>
            </div>
            <div class="revenue-card">
                <div class="bubble" style="color:var(--ink)">
                    ▤
