      <!-- MAIN – Sayfa içeriği alanı -->
<main class="layout">
    <!-- Sayfa başlığı: ikon, başlık, açıklama -->
    <div class="page-head">
        <div class="page-icon">
            <svg class="svg-icon" viewbox="0 0 24 24" aria-hidden="true" fill="none"
                 stroke="currentcolor" stroke-width="1.8" stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="M3 20h18M5 16l4-5 4 3 7-9M16 5h4v4"></path>
            </svg>
        </div>
        <div>
            <h1>Ciro / Turnover</h1>
            <p>Genel Bakış Ihrer Umsätze.</p>
        </div>
        <div class="head-action">
            <button class="page-close" data-close-page="" aria-label="Muhasebeyi Kapat"
                    title="Kapat">
                <svg class="svg-icon" viewbox="0 0 24 24" aria-hidden="true" fill="none"
                     stroke="currentcolor" stroke-width="1.8" stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M5 5l14 14M19 5 5 19"></path>
                </svg>
            </button>
        </div>
    </div>
    <section class="card card-pad turnover-period-card">
        <h2 class="section-title">Dönem Seç</h2>
        <div class="date-tabs turnover-date-tabs">
            <button class="tab" data-turnover-period="today">Bugün</button> <button class="tab"
                                                                                    data-turnover-period="yesterday">
                Dün
            </button> <button class="tab active"
                              data-turnover-period="week">
                1 Hafta
            </button> <button class="tab"
                              data-turnover-period="month">
                Bu Ay
            </button>
        </div><button class="custom-date turnover-custom-date"
                      data-turnover-custom-range="">
            <span>
                <svg class="svg-icon" viewbox="0 0 24 24"
                     aria-hidden="true" fill="none" stroke="currentcolor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                    <path d="M7 3v4m10-4v4M3 10h18"></path>
                </svg>
            </span><span class="custom-date-label">Individuell</span><span>
                <svg class="svg-icon" viewbox="0 0 24 24" aria-hidden="true" fill="none"
                     stroke="currentcolor" stroke-width="1.8" stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="m9 5 7 7-7 7"></path>
                </svg>
            </span>
        </button>
    </section>
    <section class="card turnover-summary-card" style="margin-top:16px">
        <div class="revenue-top">
            <div class="revenue-card">
                <div class="bubble" style="color:var(--green)">
