                     style="border-bottom:2px solid var(--green);transform:skewY(-5deg)"></div>
            </div>
            <div class="revenue-card">
                <div class="bubble" style="color:var(--red)">
                    <svg class="svg-icon" viewbox="0 0 24 24" aria-hidden="true" fill="none"
